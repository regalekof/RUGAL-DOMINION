# Helius API key from https://dashboard.helius.dev/
# Use a restricted key in production because this is used by the browser wallet adapter.
NEXT_PUBLIC_HELIUS_API_KEY=your-helius-api-key

# Optional: mainnet-beta (default) or devnet
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Optional: shared leaderboard and profile database. Without these, the UI uses local storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
